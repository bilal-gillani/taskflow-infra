# Terraform
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfplan
.terraform.lock.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive variable files — never commit these
*.tfvars
!terraform.tfvars.example

# Ansible
*.retry
ansible/inventory/hosts.ini    # auto-generated by CI — not committed
ansible/.vault_pass

# SSH keys — never commit private keys
*.pem
id_rsa
id_ed25519
taskflow_deploy
az-vm-ssh

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
